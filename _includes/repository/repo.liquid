{% assign r = null %}
{% for candidate in site.data.github.repos %}
  {% assign a = candidate.full_name | downcase %}
  {% assign b = include.repository | downcase %}
  {% if a == b %}
    {% assign r = candidate %}
  {% endif %}
{% endfor %}
{% if r %}
  <a class="gh-card gh-repo" href="{{ r.url }}" title="{{ r.full_name }} on GitHub">
    <div class="gh-title">
      <i class="fa-solid fa-book-bookmark"></i>
      <span class="gh-owner">{{ r.owner }}/</span>{{ r.name }}
    </div>
    {% if r.description != '' %}
      <div class="gh-desc">{{ r.description }}</div>
    {% endif %}
    <div class="gh-meta">
      {% if r.language != '' -%}
        <span><span class="gh-dot"></span>{{ r.language }}</span>
      {%- endif %}
      <span><i class="fa-regular fa-star"></i> {{ r.stars }}</span>
      <span><i class="fa-solid fa-code-fork"></i> {{ r.forks }}</span>
    </div>
  </a>
{% endif %}
