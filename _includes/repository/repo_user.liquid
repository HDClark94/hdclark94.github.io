{% assign u = null %}
{% for candidate in site.data.github.users %}
  {% assign a = candidate.login | downcase %}
  {% assign b = include.username | downcase %}
  {% if a == b %}
    {% assign u = candidate %}
  {% endif %}
{% endfor %}
{% if u %}
  <a class="gh-card gh-user" href="{{ u.url }}" title="{{ u.login }} on GitHub">
    <img class="gh-avatar" src="{{ u.avatar }}" alt="" loading="lazy" width="56" height="56">
    <div class="gh-user-body">
      <div class="gh-title">{{ u.name }}</div>
      <div class="gh-login">@{{ u.login }}</div>
      {% if u.bio != '' %}
        <div class="gh-desc">{{ u.bio }}</div>
      {% endif %}
      <div class="gh-meta">
        <span><i class="fa-solid fa-book-bookmark"></i> {{ u.public_repos }} repositories</span>
        <span><i class="fa-solid fa-user-group"></i> {{ u.followers }} followers</span>
      </div>
    </div>
  </a>
{% endif %}
